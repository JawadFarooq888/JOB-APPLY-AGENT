# Copy this file to ".env" and fill in your values.  NEVER upload .env to GitHub.

# Google Gemini (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Sheet: the long ID in the sheet link
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Google service account key file (downloaded JSON) - path on your PC
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
# (On GitHub we use GOOGLE_SERVICE_ACCOUNT_JSON = the whole file content instead.)

# Adzuna (free, optional): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Daily email (optional) - Gmail + App Password
# https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_TO=
